<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Shared by the app and the share extension (project.yml adds it to both as a
  resource). Every entry below was checked against the source rather than
  guessed; see "Privacy manifest" in SHIPPING.md for how to re-check it.

  FileTimestamp / C617.1
      FileManager.attributesOfItem(atPath:) reading [.size], in JPEGEncoder,
      ImageNormaliser and OutputVerifier. Only ever on files inside the app
      container, the App Group container or the temporary directory.

  UserDefaults / 1C8F.1
      ExportStore, via UserDefaults(suiteName: BundleConfig.appGroupID). 1C8F.1
      is the App Group reason. CA92.1 — the app's own defaults — would be the
      wrong code here, and UserDefaults.standard is never touched.

  Deliberately absent: DiskSpace (no capacity API is called anywhere),
  SystemBootTime (no systemUptime or mach_absolute_time), ActiveKeyboards.
  NSPrivacyCollectedDataTypes is empty because the app collects nothing and
  makes no network requests of any kind.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array><string>C617.1</string></array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array><string>1C8F.1</string></array>
		</dict>
	</array>
</dict>
</plist>
